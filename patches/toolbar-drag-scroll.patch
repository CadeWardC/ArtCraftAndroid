+    /// A press on a tool button scrolls the toolbar as it moves up or down, without picking the
+    /// tool or opening its flyout.
+    #[test]
+    fn dragging_a_tool_button_scrolls_the_toolbar() {
+        let mut app = VectorcraftApp::new(Session::new(), Default::default());
+        app.run("file.new", json!({"width": 300, "height": 300})).unwrap();
+        let ctx = egui::Context::default();
+        let tools = frame_in(&mut app, &ctx, 0.0, vec![], 500.0);
+        let before = app.session.tool_id().to_string();
+        // The third button (not the active tool's), dragged 150 pt up.
+        let from = tools[2].center();
+        let press = |pressed| Event::PointerButton { pos: from, button: PointerButton::Primary, pressed, modifiers: Default::default() };
+        frame_in(&mut app, &ctx, 0.0, vec![Event::PointerMoved(from), press(true)], 500.0);
+        let mut t = 0.0;
+        for k in 1..=15 {
+            t = f64::from(k) * 0.016;
+            frame_in(&mut app, &ctx, t, vec![Event::PointerMoved(from - vec2(0.0, 10.0 * k as f32))], 500.0);
+        }
+        let up = from - vec2(0.0, 150.0);
+        let after = frame_in(&mut app, &ctx, t + 0.016, vec![Event::PointerButton { pos: up, button: PointerButton::Primary, pressed: false, modifiers: Default::default() }], 500.0);
+        frame_in(&mut app, &ctx, t + 0.05, vec![], 500.0);
+        assert!(after[0].top() < tools[0].top() - 100.0, "scrolled: {:?} -> {:?}", tools[0], after[0]);
+        assert_eq!(app.session.tool_id(), before, "the drag picked no tool");
+        assert!(app.ui.flyout.is_none(), "nor opened a flyout");
+    }
+
     /// The tool buttons sit in the middle of the panel, between its border and the separator
     /// line, docked and floating, in one or two columns (docked, they sat 2½ pt right of centre).
     #[test]
