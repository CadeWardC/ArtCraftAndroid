+thread_local! {
+    /// Set while File → Save writes over the document's own file, not to a name or place just
+    /// picked: the Android app overwrites that file then, and asks where anything else goes.
+    static OWN_FILE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Is the write under way File → Save over the document's own file?
+pub fn saving_own_file() -> bool {
+    OWN_FILE.with(std::cell::Cell::get)
+}
